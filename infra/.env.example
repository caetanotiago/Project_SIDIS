# Copy this file to infra/.env (ignored by git) and replace the placeholders.
# Used by docker-compose.rabbitmq.yml (broker account) and by code/scripts/start-all.* (exported to every
# service replica, which reads them in spring.rabbitmq.* of application.properties).
RABBITMQ_USER=change-me-user
RABBITMQ_PASSWORD=change-me-password
# Where the services connect to the broker (defaults: localhost and 5672)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
