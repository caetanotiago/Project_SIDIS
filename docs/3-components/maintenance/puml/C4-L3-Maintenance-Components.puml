@startuml C4-L3-Maintenance-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Maintenance Service — Components (C4 Level 3)

Person(maint, "Maintenance Technician / Supervisor")
Person(atcc, "ATCC")
Container(peer, "Maintenance Service (peer replicas)", "Spring Boot", "The other 2 replicas")
Container(am, "Aircraft Management Service", "Spring Boot, 3 replicas")
ContainerDb(db, "maintenancedb-N", "H2 in-memory", "Database of THIS replica")

Container_Boundary(mt, "Maintenance Service (one replica)") {
    Component(sec, "Security & Observability filters", "common: Servlet filters", "Correlation id, audit log, X-Service-Key check, JWT authentication, role rules (MaintenanceAuthorizationRules)")
    Component(tplCtrl, "Template Controller", "Spring REST Controller", "/api/maintenance-templates — US115 (templates)")
    Component(recCtrl, "Record Controller", "Spring REST Controller", "/api/maintenance-records — US115 (records), US116, US119, US217-US219")
    Component(statCtrl, "Statistics & Alert Controllers", "Spring REST Controllers", "US117, US220, US221 (/statistics, /reports); US222 (/api/maintenance-alerts)")
    Component(tplSvc, "Template application services", "Spring Services", "Create template, view/list templates")
    Component(recSvc, "Record application services", "Spring Services", "Create, complete, categorise, view/search records")
    Component(statSvc, "Statistics & alert services", "Spring Services", "Per-replica sums/counts combined; due-maintenance check")
    Component(avail, "Aircraft availability coordinator", "AircraftAvailabilityService", "UNDER_MAINTENANCE / AVAILABLE via B3b, compensation on rollback")
    Component(replicaQ, "Replica queries", "MaintenanceReplicaQueries, Pages", "Local data + peers: find by id, merge by id, paginate after merging")
    Component(domain, "Domain model", "DDD aggregates", "MaintenanceTemplate, MaintenanceRecord, Value Objects, MaintenanceDuePolicy + DueCriterion strategies, factories")
    Component(repos, "Repositories", "Spring Data JPA", "MaintenanceTemplateRepository, MaintenanceRecordRepository (local data only)")
    Component(acl, "Anti-Corruption Layer", "AircraftClient", "Aircraft Management API -> AircraftSnapshot (B3a-B3d)")
    Component(peerClient, "PeerClient", "common", "Parallel GET to peers, first-answer / aggregation, command forwarding to the owner replica")
    Component(repClient, "ReplicatedServiceClient", "common", "Round-robin + failover over the replicas of Aircraft Management")
    Component(resil, "ResilientExecutor", "common", "Timeouts, retry with exponential backoff, circuit breaker per target")
}

Rel(maint, sec, "HTTPS + JWT")
Rel(atcc, sec, "HTTPS + JWT (US117, US220, US222)")
Rel(sec, tplCtrl, "authorised requests")
Rel(sec, recCtrl, "authorised requests")
Rel(sec, statCtrl, "authorised requests")
Rel(tplCtrl, tplSvc, "uses")
Rel(recCtrl, recSvc, "uses")
Rel(statCtrl, statSvc, "uses")
Rel(recSvc, avail, "US115 / US119")
Rel(tplSvc, domain, "uses")
Rel(recSvc, domain, "uses")
Rel(statSvc, domain, "uses")
Rel(tplSvc, replicaQ, "uses")
Rel(recSvc, replicaQ, "uses")
Rel(statSvc, replicaQ, "templates of all replicas")
Rel(replicaQ, repos, "local data")
Rel(tplSvc, repos, "writes")
Rel(recSvc, repos, "writes")
Rel(statSvc, repos, "local sums / counts")
Rel(repos, db, "JPA/JDBC")
Rel(replicaQ, peerClient, "data of other replicas")
Rel(statSvc, peerClient, "partial results of other replicas")
Rel(recSvc, peerClient, "PATCH to owner replica")
Rel(tplSvc, acl, "models exist (B3c)")
Rel(recSvc, acl, "aircraft exists + model (B3a)")
Rel(avail, acl, "status update (B3b)")
Rel(statSvc, acl, "fleet + flight hours (B3d)")
Rel(acl, repClient, "uses")
Rel(peerClient, resil, "uses")
Rel(repClient, resil, "uses")
Rel(resil, peer, "GET/PATCH", "JSON/HTTPS, X-Peer-Hops: 1")
Rel(resil, am, "GET /api/aircrafts, /api/aircraft-models; PATCH status", "JSON/HTTPS")

SHOW_LEGEND()
@enduml
