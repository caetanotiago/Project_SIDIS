@startuml C4-L3-Maintenance-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Maintenance Service — Components (C4 Level 3, CQRS)

AddRelTag("amqp", $lineColor="#d9480f", $textColor="#d9480f", $lineStyle=DashedLine())

Person(users, "Maintenance Technician / Supervisor, ATCC")
Container(peer, "Maintenance Service (peer replicas)", "Spring Boot", "The other 2 replicas (owners of their own records)")
Container(am, "Aircraft Management Service", "Spring Boot, 3 replicas", "B3b PATCH status (HTTP command); publishes aircraft / model events")
Container(fr, "Flight Routes Service", "Spring Boot, 3 replicas", "publishes scheduled-flight events")
ContainerQueue(mq, "RabbitMQ", "AMQP", "publishes aisafe.maintenance.events; queues <instanceId>.maintenance, .aircraftmanagement, .flightroutes (+ .dlq)")
ContainerDb(db, "maintenancedb-N", "H2 file", "Database of THIS replica: write model, read models, KNOWN_*, PROCESSED_EVENT")

Container_Boundary(mt, "Maintenance Service (one replica)") {
    Component(sec, "Security & Observability filters", "common: Servlet filters", "Correlation id, audit log, X-Service-Key check, JWT, role rules (MaintenanceAuthorizationRules)")
    Component(ctrl, "Controllers", "Spring REST", "MaintenanceTemplateController, MaintenanceRecordController, MaintenanceStatisticsController, MaintenanceAlertController — unchanged REST API")

    Component(cmd, "Command side", "package command", "Create template, create / complete / categorise record: validate, write the owner's write model, emit the event")
    Component(avail, "Aircraft availability coordinator", "AircraftAvailabilityService", "B3b UNDER_MAINTENANCE (compensated on rollback) / AVAILABLE when no other record is ongoing")
    Component(emitter, "Event emitter + relay", "MaintenanceEventEmitter, IntegrationEventRelay, ReadModelSynchronizer", "Build ONE event, apply it locally in the write transaction, publish after the commit; startup sync")
    Component(writeRepo, "Write model", "Spring Data JPA", "MaintenanceTemplateRepository, MaintenanceRecordRepository: rows OWNED by this replica")

    Component(qry, "Query side", "package query", "View templates / records, statistics (US117, US220, US221), alerts (US222): local tables only")
    Component(proj, "Projections", "MaintenanceEventRouter, MaintenanceTemplateProjection, MaintenanceRecordProjection, MaintenanceEventsListener", "Idempotent (eventId), stale versions ignored")
    Component(readRepo, "Read models", "Spring Data JPA", "REPLICATED_MAINTENANCE_TEMPLATE, REPLICATED_MAINTENANCE_RECORD: data of ALL replicas")

    Component(ext, "External read models", "query.external: ExternalEventsProjection, listeners, FleetDirectory", "KNOWN_AIRCRAFT, KNOWN_AIRCRAFT_MODEL, KNOWN_SCHEDULED_FLIGHT; HTTP fallback (B3a/c/d) for data not received yet")
    Component(acl, "Anti-Corruption Layer", "AircraftClient", "Aircraft Management API -> AircraftSnapshot")
    Component(domain, "Domain model", "domain + factories", "MaintenanceTemplate, MaintenanceRecord, Value Objects, MaintenanceDuePolicy + DueCriterion strategies")
    Component(peerClient, "PeerClient / ReplicatedServiceClient / ResilientExecutor", "common", "Forward commands to the owner; round-robin + failover; timeouts, retry, circuit breaker")
}

Rel(users, sec, "HTTPS + JWT")
Rel(sec, ctrl, "authorised requests")
Rel(ctrl, cmd, "POST, PATCH")
Rel(ctrl, qry, "GET")
Rel(cmd, domain, "aggregates")
Rel(cmd, writeRepo, "save + flush")
Rel(cmd, readRepo, "template lookup, unique name")
Rel(cmd, ext, "aircraft, models")
Rel(cmd, avail, "US115 / US119")
Rel(cmd, peerClient, "PATCH of a record owned by a peer")
Rel(cmd, emitter, "templateCreated / recordCreated / recordCategorized / recordCompleted")
Rel(emitter, proj, "own event, same transaction")
Rel(emitter, mq, "publish after commit", "AMQP", $tags="amqp")
Rel(mq, proj, "every Maintenance event + MaintenanceSyncRequested", "AMQP", $tags="amqp")
Rel(mq, ext, "aircraft.*, aircraft-model.*, scheduled-flight.*", "AMQP", $tags="amqp")
Rel(am, mq, "publishes AircraftRegistered / StatusChanged, AircraftModel*", "AMQP", $tags="amqp")
Rel(fr, mq, "publishes ScheduledFlightCreated", "AMQP", $tags="amqp")
Rel(proj, readRepo, "upsert")
Rel(qry, readRepo, "reads")
Rel(qry, ext, "fleet, flight hours")
Rel(avail, readRepo, "other ongoing records?")
Rel(avail, acl, "B3b")
Rel(ext, acl, "fallback B3a / B3c / B3d")
Rel(acl, peerClient, "uses")
Rel(peerClient, am, "PATCH /api/aircrafts/{reg}/status (+ fallback GETs)", "JSON/HTTPS")
Rel(peerClient, peer, "PATCH to owner", "JSON/HTTPS, X-Peer-Hops: 1")
Rel(writeRepo, db, "JPA/JDBC")
Rel(readRepo, db, "JPA/JDBC")
Rel(ext, db, "JPA/JDBC")

SHOW_LEGEND()
@enduml
