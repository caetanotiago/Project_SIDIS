@startuml C4-L3-Maintenance-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Maintenance Service — Components (C4 Level 3)

Person(client, "Client")
Container(aircraftService, "Aircraft Management Service", "Spring Boot", "Manages aircraft and registrations")

Container_Boundary(maintenance, "Maintenance Service") {
    Component(controller, "MaintenanceController", "Spring REST Controller", "REST API for scheduling, completing, and querying maintenance")
    Component(service, "MaintenanceRecordService", "Spring Application Service", "Orchestrates use cases and business validation")
    Component(repository, "MaintenanceRepository", "Spring Data JPA", "Persistence interface for maintenance aggregates")
    Component(aircraftClient, "AircraftClient", "Spring HTTP Client", "Reads aircraft details and updates aircraft status")
    ContainerDb(database, "Maintenance DB", "H2", "Stores maintenance records")
}

Rel(client, controller, "Makes requests", "JSON/HTTPS")
Rel(controller, service, "Delegates use cases to")
Rel(service, repository, "Reads and writes maintenance records")
Rel(service, aircraftClient, "Validates aircraft registration")
Rel(repository, database, "Reads and writes", "JPA")
Rel(aircraftClient, aircraftService, "Checks aircraft registration", "HTTP/JSON")

SHOW_LEGEND()
@enduml
