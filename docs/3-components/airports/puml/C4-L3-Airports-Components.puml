@startuml C4-L3-Airports-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Airports Service — Components (C4 Level 3)

Person(user, "Backoffice Operator / ATCC")
Container(peer, "Airports Service (peer replicas)", "Spring Boot", "The other 2 replicas")
Container(fr, "Flight Routes Service", "Spring Boot, 3 replicas", "Consumer of GET /api/airports/{iata} (B2) and provider of route counts (B5)")
ContainerDb(db, "airportsdb-N", "H2 in-memory", "Database of THIS replica")

Container_Boundary(ap, "Airports Service (one replica)") {
    Component(sec, "Security & Observability filters", "common: Servlet filters", "Correlation id, audit log, X-Service-Key check, JWT authentication, role rules (AirportsAuthorizationRules)")
    Component(ctrl, "Airport Controller", "Spring REST Controller", "/api/airports — US106-US109, US106a, US207, US208, US210, US211")
    Component(svc, "Application services", "Spring Services", "RegisterAirportService, SearchAirportsService, UpdateAirportService, AirportStatisticsService, GroupAirportsService")
    Component(replicaQ, "Replica queries", "Spring Component", "AirportReplicaQueries: local data + peers, merged by IATA code")
    Component(domain, "Domain model", "DDD aggregate", "Airport (root), Coordinates, Runway, AirportStatus, IataCode; AirportFactory")
    Component(repo, "Repository", "Spring Data JPA", "AirportRepository (local data only)")
    Component(acl, "Anti-Corruption Layer", "FlightRoutesClient", "Route counts per IATA (B5)")
    Component(peerClient, "PeerClient", "common", "Parallel GET to peers, first-answer / aggregation, command forwarding to the owner replica")
    Component(repClient, "ReplicatedServiceClient", "common", "Round-robin + failover over the replicas of Flight Routes")
    Component(resil, "ResilientExecutor", "common", "Timeouts, retry with exponential backoff, circuit breaker per target")
}

Rel(user, sec, "HTTPS + JWT")
Rel(fr, sec, "GET /api/airports/{iata} (B2)", "user's JWT + X-Service-Key")
Rel(sec, ctrl, "authorised requests")
Rel(ctrl, svc, "uses")
Rel(svc, replicaQ, "reads")
Rel(svc, domain, "uses")
Rel(svc, repo, "writes")
Rel(replicaQ, repo, "local data")
Rel(repo, db, "JPA/JDBC")
Rel(replicaQ, peerClient, "data of other replicas")
Rel(svc, peerClient, "commands to the owner replica")
Rel(svc, acl, "US210")
Rel(acl, repClient, "uses")
Rel(peerClient, resil, "uses")
Rel(repClient, resil, "uses")
Rel(resil, peer, "GET/POST/PATCH", "JSON/HTTPS, X-Peer-Hops: 1")
Rel(resil, fr, "GET /api/routes/statistics/count-by-airport", "JSON/HTTPS")

SHOW_LEGEND()
@enduml
