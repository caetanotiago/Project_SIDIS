@startuml C4-L3-Airports-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Airports Service — Components (C4 Level 3, Assignment 2: CQRS + AMQP)

Person(user, "Backoffice Operator / ATCC")
Container(peer, "Airports Service (peer replicas)", "Spring Boot", "Owner of the airports it registered")
Container(fr, "Flight Routes Service", "Spring Boot", "Publishes route events; consumes airport events (B2)")
ContainerQueue(mq, "RabbitMQ", "AMQP broker", "aisafe.airports.events, aisafe.flightroutes.events, aisafe.dlx")
ContainerDb(db, "airportsdb-N", "H2 file", "Database of THIS replica: write model + read models")

Container_Boundary(ap, "Airports Service (one replica)") {
    Component(sec, "Security & Observability filters", "common: Servlet filters", "Correlation id, audit, X-Service-Key, JWT, AirportsAuthorizationRules")
    Component(ctrl, "Airport Controller", "Spring REST Controller", "/api/airports — unchanged REST contract")
    Component(cmd, "Command side", "Spring Services", "RegisterAirportService, UpdateAirportService (owner executes; others forward)")
    Component(emit, "Event emitter & relay", "Spring", "AirportEventEmitter (local projection in the write tx), IntegrationEventRelay (publish AFTER commit)")
    Component(sync, "Read-model synchronisation", "Spring", "ReadModelSynchronizer, AirportStateRepublisher (startup / AirportSyncRequested)")
    Component(qry, "Query side", "Spring Services", "SearchAirportsService, GroupAirportsService, AirportStatisticsService")
    Component(proj, "Projections", "Spring Services", "AirportProjection → REPLICATED_AIRPORT; RouteCountProjection → KNOWN_ROUTE; idempotent")
    Component(listen, "Message listeners", "Spring AMQP @RabbitListener", "AirportsEventsListener (<id>.airports), FlightRoutesEventsListener (<id>.flightroutes)")
    Component(domain, "Domain model", "DDD aggregate", "Airport (root), Coordinates, Runway, AirportStatus, IataCode; AirportFactory")
    Component(repo, "Repositories", "Spring Data JPA", "AirportRepository (write), ReplicatedAirportRepository, KnownRouteRepository, ProcessedEventRepository")
    Component(peerClient, "PeerClient", "common", "Command forwarding to the owner replica")
    Component(pub, "EventPublisher / MessagingTopology", "common", "Exchanges, queues + DLQ, publisher confirms, consumer retry")
}

Rel(user, sec, "HTTPS + JWT")
Rel(fr, sec, "GET /api/airports/{iata} (B2 fallback)", "JWT + X-Service-Key")
Rel(sec, ctrl, "authorised requests")
Rel(ctrl, cmd, "POST / PATCH")
Rel(ctrl, qry, "GET")
Rel(cmd, domain, "uses")
Rel(cmd, emit, "after saveAndFlush")
Rel(cmd, peerClient, "not the owner")
Rel(emit, proj, "same transaction")
Rel(emit, pub, "after commit")
Rel(sync, emit, "republish owned airports")
Rel(sync, pub, "AirportSyncRequested")
Rel(listen, proj, "airport / route events")
Rel(listen, sync, "sync requests of other replicas")
Rel(qry, repo, "read models")
Rel(proj, repo, "upsert")
Rel(cmd, repo, "write model")
Rel(repo, db, "JPA/JDBC")
Rel(pub, mq, "publish", "AMQP")
Rel(mq, listen, "deliver (one queue per instance)", "AMQP")
Rel(peerClient, peer, "POST/PATCH", "JSON/HTTPS, X-Peer-Hops: 1")
Rel(fr, mq, "route.created / route.updated", "AMQP")

SHOW_LEGEND()
@enduml
