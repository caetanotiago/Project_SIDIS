@startuml C4-L3-AircraftManagement-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Aircraft Management Service — Components (C4 Level 3)

Person(atcc, "ATCC", "Air Transport Company Collaborator")
Person(bo, "Backoffice Operator")
System_Ext(fr, "Flight Routes Service", "Consumer (B1) and supplier (B4, B6)")
System_Ext(mt, "Maintenance Service", "Consumer (B3)")

Container(peer, "Aircraft Management Service (peer replicas)", "Spring Boot", "The other two replicas")
ContainerDb(db, "aircraftManagementdb-N", "H2 in-memory", "Database of THIS replica")

Container_Boundary(svc, "Aircraft Management Service (one replica)") {
    Component(sec, "Security & Observability filters", "common + AircraftManagementAuthorizationRules", "Correlation id, audit log, X-Service-Key, JWT, roles per endpoint")
    Component(ctrlA, "Aircraft controllers", "AircraftController, AircraftStatisticsController", "/api/aircrafts — US102–US105, US203, US206")
    Component(ctrlM, "Aircraft model controllers", "AircraftModelController, AircraftModelStatisticsController", "/api/aircraft-models — US101, US204, contract B1b")
    Component(app, "Application services", "Spring Services", "One service per use case")
    Component(rq, "Replica queries", "AircraftReplicaQueries", "Local data + peers: find by id, merge by registration")
    Component(domain, "Domain model", "Aircraft, AircraftModel, AircraftStatus, read models", "Aggregates and invariants")
    Component(repos, "Repositories", "Spring Data JPA", "Data of this replica only")
    Component(acl, "Anti-Corruption Layer", "FlightRoutesClient", "Translates the Flight Routes API (B4b, B6)")
    Component(peerClient, "PeerClient", "common", "findFirst / collectList / forwardToOwner")
    Component(rsc, "ReplicatedServiceClient", "common", "Round-robin + failover + circuit breaker towards Flight Routes")
}

System_Ext(frReplicas, "Flight Routes replicas", "3 replicas")

Rel(atcc, sec, "HTTP(S) + JWT")
Rel(bo, sec, "HTTP(S) + JWT")
Rel(fr, sec, "HTTP(S) + JWT (forwarded)", "GET aircraft / model (B1)")
Rel(mt, sec, "HTTP(S) + JWT (forwarded)", "GET aircraft (B3a), PATCH status (B3b)")
Rel(sec, ctrlA, "authorised requests")
Rel(sec, ctrlM, "authorised requests")
Rel(ctrlA, app, "uses")
Rel(ctrlM, app, "uses")
Rel(app, domain, "uses")
Rel(app, rq, "reads all replicas")
Rel(app, repos, "uses")
Rel(rq, repos, "local data")
Rel(rq, peerClient, "data of other replicas")
Rel(app, peerClient, "forwards commands to the owner")
Rel(app, acl, "usage statistics, compatible routes")
Rel(repos, db, "JPA/JDBC")
Rel(peerClient, peer, "GET / PATCH", "JSON/HTTP(S), X-Peer-Hops: 1")
Rel(acl, rsc, "uses")
Rel(rsc, frReplicas, "GET", "JSON/HTTP(S), JWT forwarded")

SHOW_LEGEND()
@enduml
