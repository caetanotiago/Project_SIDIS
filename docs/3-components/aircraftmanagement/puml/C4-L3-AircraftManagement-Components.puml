@startuml C4-L3-AircraftManagement-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Aircraft Management Service — Components (C4 Level 3)

Person(user, "Gestor de Frota")
System_Ext(flightRoutes, "Flight Routes / Maintenance", "Consome dados dos aviões")

Container(peer, "Aircraft Management Service (peer replicas)", "Spring Boot")
ContainerDb(db, "aircraftManagementdb-N", "H2 in-memory", "Database of THIS replica")

Container_Boundary(svc, "Aircraft Management Service (one replica)") {
    Component(sec, "Security & Observability filters", "common", "JWT, X-Service-Key, audit, correlation id")
    Component(ctrl, "Aircraft Controller", "Spring REST Controller", "Endpoints HTTP (aeronaves e modelos)")
    Component(app, "Aircraft Service", "Spring Services", "Regras de negócio e lógica P2P")
    Component(domain, "Domain model", "Aircraft, AircraftModel", "Entidades principais e Value Objects")
    Component(repos, "Repositories", "Spring Data JPA", "local data")
    Component(peerClient, "PeerClient", "common", "peer forwarding / aggregation")
}

Rel(user, sec, "HTTPS + JWT")
Rel(flightRoutes, sec, "HTTPS + X-Service-Key", "Consulta avião")
Rel(sec, ctrl, "authorised requests")
Rel(ctrl, app, "uses")
Rel(app, domain, "uses")
Rel(app, repos, "uses")
Rel(repos, db, "JPA/JDBC")
Rel(app, peerClient, "data of other replicas")
Rel(peerClient, peer, "GET", "JSON/HTTPS, X-Peer-Hops: 1")

SHOW_LEGEND()
@enduml