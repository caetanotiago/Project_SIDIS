@startuml C4-L3-AircraftManagement-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Aircraft Management Service — Components (C4 Level 3, CQRS)

AddRelTag("amqp", $lineColor="#d9480f", $textColor="#d9480f", $lineStyle=DashedLine())

Person(users, "ATCC / Backoffice Operator / Maintenance")
Container(peer, "Aircraft Management Service (peer replicas)", "Spring Boot", "The other 2 replicas (owners of their own aircraft and models)")
Container(fr, "Flight Routes Service", "Spring Boot, 3 replicas", "B1 consumer (HTTP); publishes route / scheduled-flight events")
Container(mt, "Maintenance Service", "Spring Boot, 3 replicas", "B3 consumer (HTTP; B3b is a command)")
ContainerQueue(mq, "RabbitMQ", "AMQP", "publishes aisafe.aircraftmanagement.events; queues <instanceId>.aircraftmanagement and <instanceId>.flightroutes (+ .dlq)")
ContainerDb(db, "aircraftManagementdb-N", "H2 file", "Database of THIS replica: write model, read models, KNOWN_*, PROCESSED_EVENT")

Container_Boundary(am, "Aircraft Management Service (one replica)") {
    Component(sec, "Security & Observability filters", "common: Servlet filters", "Correlation id, audit log, X-Service-Key check, JWT authentication, role rules (AircraftManagementAuthorizationRules)")
    Component(ctrl, "Controllers", "Spring REST", "AircraftController, AircraftModelController, *StatisticsController, AircraftAvailabilityController, UnicornsController — unchanged REST API + /api/v2/unicorns")

    Component(cmd, "Command side", "package command", "CreateAircraftModelService, UpdateAircraftModelService, CreateAircraftService, UpdateAircraftStatusService: validate, write the owner's write model, emit the event")
    Component(emitter, "Event emitter + relay", "AircraftManagementEventEmitter, IntegrationEventRelay, ReadModelSynchronizer", "Build ONE event, apply it to the local read model in the write transaction, publish it after the commit")
    Component(writeRepo, "Write model", "Spring Data JPA", "AircraftRepository, AircraftModelRepository: rows OWNED by this replica")

    Component(qry, "Query side", "package query", "Search*, AircraftAvailability, CalculateOperationalHours, TopUtilizedModels, FindCompatibleRoutes, AircraftMoodQuery: read local read models only")
    Component(proj, "Projections", "AircraftManagementEventRouter, AircraftProjection, AircraftModelProjection", "Idempotent (eventId), stale versions ignored")
    Component(readRepo, "Read models", "Spring Data JPA", "REPLICATED_AIRCRAFT, REPLICATED_AIRCRAFT_MODEL, AIRCRAFT_MOOD: data of ALL replicas")
    Component(listener, "Event listener", "AircraftManagementEventsListener (@RabbitListener)", "Own queue; ack after commit; retry then DLQ")

    Component(ext, "Flight Routes read models", "query.external: FlightRoutesEventsListener, FlightRoutesEventsProjection", "KNOWN_ROUTE, KNOWN_SCHEDULED_FLIGHT from route.* / scheduled-flight.* (replace B4b and B6)")
    Component(domain, "Domain model", "domain", "Aggregates Aircraft and AircraftModel, AircraftStatus transition rule")
    Component(peerClient, "PeerClient / ResilientExecutor", "common", "Forward commands to the owner replica; timeouts, retry, circuit breaker")
}

Rel(users, sec, "HTTPS + JWT")
Rel(fr, sec, "B1a/B1b GET aircraft / model", "JSON/HTTPS")
Rel(mt, sec, "B3a/B3c/B3d GET, B3b PATCH status", "JSON/HTTPS")
Rel(sec, ctrl, "authorised requests")
Rel(ctrl, cmd, "POST, PATCH")
Rel(ctrl, qry, "GET")
Rel(cmd, domain, "aggregates")
Rel(cmd, writeRepo, "save + flush")
Rel(cmd, readRepo, "uniqueness / model exists")
Rel(cmd, peerClient, "PATCH of an entity owned by a peer")
Rel(cmd, emitter, "aircraftRegistered / aircraftStatusChanged / aircraftModelCreated / aircraftModelUpdated")
Rel(emitter, proj, "own event, same transaction")
Rel(emitter, mq, "publish after commit", "AMQP", $tags="amqp")
Rel(mq, listener, "every Aircraft Management event + AircraftSyncRequested", "AMQP", $tags="amqp")
Rel(mq, ext, "route.*, scheduled-flight.* (Flight Routes)", "AMQP", $tags="amqp")
Rel(fr, mq, "publishes RouteCreated/Updated, ScheduledFlightCreated", "AMQP", $tags="amqp")
Rel(listener, proj, "apply")
Rel(proj, readRepo, "upsert")
Rel(qry, readRepo, "reads")
Rel(qry, ext, "routes, flight minutes")
Rel(writeRepo, db, "JPA/JDBC")
Rel(readRepo, db, "JPA/JDBC")
Rel(ext, db, "JPA/JDBC")
Rel(peerClient, peer, "PATCH to owner", "JSON/HTTPS, X-Peer-Hops: 1")

SHOW_LEGEND()
@enduml
