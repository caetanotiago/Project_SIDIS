@startuml C4-L3-FlightRoutes-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Flight Routes Service — Components (C4 Level 3, CQRS)

AddRelTag("amqp", $lineColor="#d9480f", $textColor="#d9480f", $lineStyle=DashedLine())

Person(atcc, "ATCC / Backoffice Operator")
Container(peer, "Flight Routes Service (peer replicas)", "Spring Boot", "The other 2 replicas (owners of their own routes and flights)")
Container(ap, "Airports Service", "Spring Boot, 3 replicas")
Container(am, "Aircraft Management Service", "Spring Boot, 3 replicas")
ContainerQueue(mq, "RabbitMQ", "AMQP", "aisafe.flightroutes.events; queue <instanceId>.flightroutes (+ .dlq)")
ContainerDb(db, "flightRoutesdb-N", "H2 file", "Database of THIS replica: write model, read models, PROCESSED_EVENT")

Container_Boundary(fr, "Flight Routes Service (one replica)") {
    Component(sec, "Security & Observability filters", "common: Servlet filters", "Correlation id, audit log, X-Service-Key check, JWT authentication, role rules (FlightRoutesAuthorizationRules)")
    Component(ctrl, "Controllers", "Spring REST", "FlightRouteController (/api/routes), ScheduledFlightController (/api/scheduled-flights) — unchanged REST API")

    Component(cmd, "Command side", "package command", "CreateFlightRouteService, UpdateFlightRouteService, CreateScheduledFlightService: validate, write the owner's write model, emit the event")
    Component(emitter, "Event emitter + relay", "FlightRoutesEventEmitter, IntegrationEventRelay", "Build ONE event, apply it to the local read model in the write transaction, publish it after the commit")
    Component(writeRepo, "Write model", "Spring Data JPA", "FlightRouteRepository, ScheduledFlightRepository: rows OWNED by this replica")

    Component(qry, "Query side", "package query", "Search*, View*, Count*, List*, Calculate*, GetRouteHistory, statistics: read the local read models only")
    Component(proj, "Projections", "FlightRoutesEventRouter, RouteProjection, ScheduledFlightProjection", "Idempotent (eventId), stale versions ignored")
    Component(readRepo, "Read models", "Spring Data JPA", "REPLICATED_ROUTE (+history), REPLICATED_SCHEDULED_FLIGHT: data of ALL replicas")
    Component(listener, "Event listener", "FlightRoutesEventsListener (@RabbitListener)", "Own queue; ack after commit; retry then DLQ")

    Component(ext, "External read models (off)", "query.external", "KNOWN_AIRCRAFT/MODEL/AIRPORT from Aircraft Management / Airports events (aisafe.flightroutes.external-events.enabled)")
    Component(acl, "Anti-Corruption Layer", "AirportClient, AircraftClient", "Local external read model first (when enabled), else HTTP B1/B2")
    Component(strategies, "Strategies + domain", "domain, factories, services.strategy", "Aggregates FlightRoute / ScheduledFlight; sorting and alternative-route strategies")
    Component(peerClient, "PeerClient / ReplicatedServiceClient / ResilientExecutor", "common", "Forward commands to the owner; round-robin + failover; timeouts, retry, circuit breaker")
}

Rel(atcc, sec, "HTTPS + JWT")
Rel(am, sec, "B4b, B6 (service-only)", "JSON/HTTPS + X-Service-Key")
Rel(ap, sec, "B5 (service-only)", "JSON/HTTPS + X-Service-Key")
Rel(sec, ctrl, "authorised requests")
Rel(ctrl, cmd, "POST, PATCH")
Rel(ctrl, qry, "GET")
Rel(cmd, strategies, "aggregates")
Rel(cmd, writeRepo, "save + flush")
Rel(cmd, readRepo, "uniqueness / route / overlap checks")
Rel(cmd, acl, "aircraft, airports")
Rel(cmd, peerClient, "PATCH of a route owned by a peer")
Rel(cmd, emitter, "routeCreated / routeUpdated / scheduledFlightCreated")
Rel(emitter, proj, "own event, same transaction")
Rel(emitter, mq, "publish after commit", "AMQP", $tags="amqp")
Rel(mq, listener, "every Flight Routes event", "AMQP", $tags="amqp")
Rel(listener, proj, "apply")
Rel(proj, readRepo, "upsert")
Rel(qry, readRepo, "reads")
Rel(qry, strategies, "sorting, BFS")
Rel(qry, acl, "airport exists (US209, US216), aircraft exists (US213)")
Rel(acl, ext, "local copy first")
Rel(acl, peerClient, "HTTP fallback")
Rel(writeRepo, db, "JPA/JDBC")
Rel(readRepo, db, "JPA/JDBC")
Rel(peerClient, peer, "PATCH to owner", "JSON/HTTPS, X-Peer-Hops: 1")
Rel(peerClient, ap, "B2 GET /api/airports/{iata}", "JSON/HTTPS")
Rel(peerClient, am, "B1 GET aircraft / model", "JSON/HTTPS")

SHOW_LEGEND()
@enduml
