@startuml C4-L3-FlightRoutes-Components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Flight Routes Service — Components (C4 Level 3)

Person(atcc, "ATCC / Backoffice Operator")
Container(peer, "Flight Routes Service (peer replicas)", "Spring Boot", "The other 2 replicas")
Container(ap, "Airports Service", "Spring Boot, 3 replicas")
Container(am, "Aircraft Management Service", "Spring Boot, 3 replicas")
ContainerDb(db, "flightRoutesdb-N", "H2 in-memory", "Database of THIS replica")

Container_Boundary(fr, "Flight Routes Service (one replica)") {
    Component(sec, "Security & Observability filters", "common: Servlet filters", "Correlation id, audit log, X-Service-Key check, JWT authentication, role rules (FlightRoutesAuthorizationRules)")
    Component(routeCtrl, "Flight Route Controller", "Spring REST Controller", "/api/routes — US110-US114, US203, US209, US210, US214-US216")
    Component(sfCtrl, "Scheduled Flight Controller", "Spring REST Controller", "/api/scheduled-flights — US212, US213, US206 + statistics")
    Component(routeSvc, "Route application services", "Spring Services", "Create/Update route, search, history, by airport, active routes, network distance, alternatives")
    Component(sfSvc, "Scheduled flight application services", "Spring Services", "Create flight, view per aircraft, operational hours")
    Component(replicaQ, "Replica queries", "Spring Components", "RouteReplicaQueries, ScheduledFlightStatisticsService: local data + peers, merged by id / summed")
    Component(strategies, "Strategies", "Strategy pattern", "Route sorting (popularity, distance), alternative route search (BFS min stops)")
    Component(domain, "Domain model", "DDD aggregates", "FlightRoute, ScheduledFlight, Value Objects, read models, factories")
    Component(repos, "Repositories", "Spring Data JPA", "FlightRouteRepository, ScheduledFlightRepository (local data only)")
    Component(acl, "Anti-Corruption Layer", "AirportClient, AircraftClient", "Remote DTOs -> AirportSnapshot / AircraftSnapshot")
    Component(peerClient, "PeerClient", "common", "Parallel GET to peers, first-answer / aggregation, command forwarding to the owner replica")
    Component(repClient, "ReplicatedServiceClient", "common", "Round-robin + failover over the replicas of another service")
    Component(resil, "ResilientExecutor", "common", "Timeouts, retry with exponential backoff, circuit breaker per target")
}

Rel(atcc, sec, "HTTPS + JWT")
Rel(sec, routeCtrl, "authorised requests")
Rel(sec, sfCtrl, "authorised requests")
Rel(routeCtrl, routeSvc, "uses")
Rel(sfCtrl, sfSvc, "uses")
Rel(routeSvc, replicaQ, "uses")
Rel(sfSvc, replicaQ, "uses")
Rel(routeSvc, strategies, "uses")
Rel(routeSvc, domain, "uses")
Rel(sfSvc, domain, "uses")
Rel(routeSvc, acl, "airports")
Rel(sfSvc, acl, "aircraft, airports")
Rel(replicaQ, repos, "local data")
Rel(routeSvc, repos, "writes")
Rel(sfSvc, repos, "writes")
Rel(repos, db, "JPA/JDBC")
Rel(replicaQ, peerClient, "data of other replicas")
Rel(routeSvc, peerClient, "PATCH to owner replica")
Rel(acl, repClient, "uses")
Rel(peerClient, resil, "uses")
Rel(repClient, resil, "uses")
Rel(resil, peer, "GET/PATCH", "JSON/HTTPS, X-Peer-Hops: 1")
Rel(resil, ap, "GET /airports/{iata}", "JSON/HTTPS")
Rel(resil, am, "GET /api/aircrafts, /api/aircraft-models", "JSON/HTTPS")

SHOW_LEGEND()
@enduml
