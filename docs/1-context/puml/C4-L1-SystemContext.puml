@startuml C4-L1-SystemContext
!include <C4/C4_Context>
LAYOUT_TOP_DOWN()
title AISafe — System Context (C4 Level 1)

Person(backoffice, "Backoffice Operator", "Registers airports and aircraft models; updates/deactivates routes; consults statistics.")
Person(atcc, "Air Traffic Control Coordinator (ATCC)", "Registers aircraft; defines flight routes and schedules flights; consults airports and the route network.")
Person(maint, "Maintenance Technician / Supervisor", "Plans and records aircraft maintenance.")

System(aisafe, "AISafe Flight Management System", "Distributed system that manages the fleet, airports, flight routes, scheduled flights and maintenance of an airline.")

Rel(backoffice, aisafe, "Registers airports and aircraft models; manages routes; reads statistics")
Rel(atcc, aisafe, "Registers aircraft, creates routes, schedules flights, queries airports and the network")
Rel(maint, aisafe, "Records maintenance and checks aircraft status")

SHOW_LEGEND()
@enduml
