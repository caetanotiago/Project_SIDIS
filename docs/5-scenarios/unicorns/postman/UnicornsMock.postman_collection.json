{
  "info": {
    "name": "AISafe - Unicorns Mock",
    "description": "Mock endpoint required by SIDIS Assignment 2: GET /api/v2/unicorns returns the \"mood\" of every aircraft, derived from its operational status.\n\nIt is a pure QUERY of the read side (CQRS): the contract is what a projection built from Aircraft Management's AircraftStatusChanged events would return. Nothing is written and no write model is touched, so it can be served by a Postman mock server while the real projection does not exist.\n\nMood rule: AVAILABLE -> HAPPY, IN_FLIGHT -> BUSY, UNDER_MAINTENANCE -> GROUNDED_AND_GRUMPY, anything else -> NEUTRAL.\n\nHow to create and run the mock server: docs/2-containers/Unicorns-Mock.md. Environment: UnicornsMock.postman_environment.json (variable unicornsMockUrl).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /api/v2/unicorns - aircraft moods (read model)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{unicornsMockUrl}}/api/v2/unicorns",
          "host": [
            "{{unicornsMockUrl}}"
          ],
          "path": [
            "api",
            "v2",
            "unicorns"
          ]
        },
        "description": "Query only. Each item is one aircraft as known by the read model (registration, model, operational status), plus the derived mood, the time of the last status event applied and source = \"read-model\"."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const MOODS = { AVAILABLE: 'HAPPY', IN_FLIGHT: 'BUSY', UNDER_MAINTENANCE: 'GROUNDED_AND_GRUMPY' };",
              "",
              "pm.test('only GET is used (pure query, read side)', () => pm.expect(pm.request.method).to.eql('GET'));",
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('content type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "",
              "const body = pm.response.json();",
              "pm.test('body is a JSON array', () => pm.expect(body).to.be.an('array').that.is.not.empty);",
              "pm.test('each item has registration and mood', () => body.forEach(a => {",
              "    pm.expect(a).to.have.property('registration').that.is.a('string').and.not.empty;",
              "    pm.expect(a).to.have.property('mood').that.is.a('string').and.not.empty;",
              "}));",
              "pm.test('each mood is derived from the operational status', () => body.forEach(a =>",
              "    pm.expect(a.mood).to.eql(MOODS[a.operationalStatus] || 'NEUTRAL')));",
              "pm.test('served from the read model, with a timestamp', () => body.forEach(a => {",
              "    pm.expect(a.source).to.eql('read-model');",
              "    pm.expect(new Date(a.timestamp).toString()).to.not.eql('Invalid Date');",
              "}));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 - aircraft moods",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{unicornsMockUrl}}/api/v2/unicorns",
              "host": [
                "{{unicornsMockUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "unicorns"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "[\n  {\n    \"registration\": \"CS-TUA\",\n    \"model\": \"A320\",\n    \"operationalStatus\": \"AVAILABLE\",\n    \"mood\": \"HAPPY\",\n    \"timestamp\": \"2026-11-18T09:15:00Z\",\n    \"source\": \"read-model\"\n  },\n  {\n    \"registration\": \"CS-TUB\",\n    \"model\": \"A321\",\n    \"operationalStatus\": \"IN_FLIGHT\",\n    \"mood\": \"BUSY\",\n    \"timestamp\": \"2026-11-18T10:02:41Z\",\n    \"source\": \"read-model\"\n  },\n  {\n    \"registration\": \"CS-TUC\",\n    \"model\": \"E195\",\n    \"operationalStatus\": \"UNDER_MAINTENANCE\",\n    \"mood\": \"GROUNDED_AND_GRUMPY\",\n    \"timestamp\": \"2026-11-17T22:47:10Z\",\n    \"source\": \"read-model\"\n  },\n  {\n    \"registration\": \"CS-TUD\",\n    \"model\": \"ATR72\",\n    \"operationalStatus\": \"INACTIVE\",\n    \"mood\": \"NEUTRAL\",\n    \"timestamp\": \"2026-11-01T08:00:00Z\",\n    \"source\": \"read-model\"\n  }\n]"
        }
      ]
    }
  ]
}
