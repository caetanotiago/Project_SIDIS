@startuml FlightRoutes-SD-CreateScheduledFlight
autonumber
actor "ATCC" as ATCC

participant ": ScheduledFlightController" as Ctrl <<Controller>>
participant ": CreateScheduledFlightService" as Service <<command>>
participant ": AircraftClient" as AcClient <<ACL>>
participant "Aircraft Management\n(replicas)" as AM
participant "routes : ReplicatedRouteRepository" as Routes <<read model>>
participant ": AirportClient" as ApClient <<ACL>>
participant "Airports\n(replicas)" as AP
participant "flights : ReplicatedScheduled\nFlightRepository" as Flights <<read model>>
participant ": ScheduledFlightFactory" as Factory <<Factory>>
participant "sfRepo : ScheduledFlightRepository" as SfRepo <<write model>>
participant ": FlightRoutesEventEmitter" as Emitter

activate ATCC
ATCC -> Ctrl : POST /api/scheduled-flights (CreateScheduledFlightDTO)
activate Ctrl
Ctrl -> Service : create(dto)
activate Service

Service -> AcClient : getAircraft(registration)
activate AcClient
AcClient -> AM : GET /api/aircrafts/{reg}\n(round-robin, failover)
AM --> AcClient : AircraftDTO
AcClient -> AM : GET /api/aircraft-models/{model}
AM --> AcClient : AircraftModelDTO
AcClient --> Service : AircraftSnapshot
deactivate AcClient
note right of AcClient : B1 (HTTP) until Aircraft Management\npublishes events; then KNOWN_AIRCRAFT

Service -> Routes : findById(routeID)
activate Routes
Routes --> Service : ReplicatedRoute → RouteSummary (404 if unknown)
deactivate Routes
note right of Routes : routes of every replica,\nno peer call

Service -> Service : route.isActive() (409)\nroute.isMetBy(range, capacity) (422)\naircraft.isAvailable() (409)

loop origin and destination
    Service -> ApClient : getAirport(iata)
    ApClient -> AP : GET /api/airports/{iata}
    AP --> ApClient : AirportDetailsResponseDTO
    ApClient --> Service : AirportSnapshot (isOperational, else 409)
end

Service -> Flights : findConflicting(reg, date, time)
activate Flights
Flights --> Service : flights of that aircraft at that slot,\nin every replica (any → 409)
deactivate Flights

Service -> Factory : create(registration, route, new FlightSchedule(date, time))
activate Factory
Factory --> Service : flight (RouteReference = routeId + route snapshot,\nstatus = SCHEDULED)
deactivate Factory

Service -> SfRepo : saveAndFlush(flight)
SfRepo --> Service : savedFlight (owned by THIS replica)
Service -> Emitter : scheduledFlightCreated(savedFlight)
note right of Emitter : ScheduledFlightCreated: local read model now,\nevery replica after the commit (S1)
Service --> Ctrl : savedFlight
deactivate Service

Ctrl --> ATCC : 201 Created, Location (ScheduledFlightDTO + self/route links)
deactivate Ctrl
deactivate ATCC
@enduml
