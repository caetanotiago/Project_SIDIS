              "raw": "{\n  \"username\": \"atcc1\",\n  \"roles\": [\n    \"ATCC\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"atccToken\", pm.response.json().token);"
