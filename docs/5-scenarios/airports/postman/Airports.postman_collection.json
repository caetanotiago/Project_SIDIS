    {
      "name": "3. Agregação de respostas (US108, US211)",
      "item": [
        {
          "name": "US108 — all airports from replica 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{atccToken}}"
              }
            ],
            "url": "{{ap1}}/api/airports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const iatas = pm.response.json().map(a => a.iataCode);",
                  "pm.test(\"6 demo airports from the 3 replicas\", () => [\"CDG\",\"FNC\",\"LHR\",\"LIS\",\"MAD\",\"OPO\"].forEach(c => pm.expect(iatas).to.include(c)));",
                  "pm.test(\"sorted by IATA\", () => pm.expect(iatas).to.eql([...iatas].sort()));",
                  "pm.test(\"complete response (no X-Partial-Response)\", () => pm.expect(pm.response.headers.has(\"X-Partial-Response\")).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "US108 — all airports from replica 3 (same answer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{atccToken}}"
              }
            ],
            "url": "{{ap3}}/api/airports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const iatas = pm.response.json().map(a => a.iataCode);",
                  "pm.test(\"same airports\", () => [\"CDG\",\"FNC\",\"LHR\",\"LIS\",\"MAD\",\"OPO\"].forEach(c => pm.expect(iatas).to.include(c)));",
                  "pm.test(\"complete response (no X-Partial-Response)\", () => pm.expect(pm.response.headers.has(\"X-Partial-Response\")).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "US108 — search by country (filter applied in every replica)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{atccToken}}"
              }
            ],
            "url": "{{ap2}}/api/airports?country=portugal"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const iatas = pm.response.json().map(a => a.iataCode);",
                  "pm.test(\"FNC (rep 3), LIS and OPO (rep 1)\", () => [\"FNC\",\"LIS\",\"OPO\"].forEach(c => pm.expect(iatas).to.include(c)));",
                  "pm.test(\"no other country\", () => pm.response.json().forEach(a => pm.expect(a.country).to.eql(\"Portugal\")));"
                ]
              }
            }
          ]
