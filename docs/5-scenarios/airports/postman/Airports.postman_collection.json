    {
      "name": "4. Comandos na réplica dona (US106, US106a, US109, US208)",
      "item": [
        {
          "name": "US106 — register a new airport on replica 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{boToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ap1}}/api/airports",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iataCode\": \"{{newIata}}\",\n  \"name\": \"Test Airport\",\n  \"city\": \"Faro\",\n  \"country\": \"Portugal\",\n  \"region\": \"Europe\",\n  \"timezone\": \"Europe/Lisbon\",\n  \"latitude\": 37.0144,\n  \"longitude\": -7.9659,\n  \"runways\": [\n    {\n      \"name\": \"10/28\",\n      \"lengthMeters\": 2490,\n      \"orientation\": 100,\n      \"surface\": \"ASPHALT\"\n    }\n  ],\n  \"terminals\": 1,\n  \"gates\": 16,\n  \"services\": [\n    \"WIFI\"\n  ],\n  \"photoUrls\": [],\n  \"operationalHours\": \"05:00-24:00\",\n  \"contactEmail\": \"info@test.pt\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const letters = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";",
                  "pm.environment.set(\"newIata\", \"Q\" + letters[Math.floor(Math.random()*26)] + letters[Math.floor(Math.random()*26)]);",
                  "pm.environment.set(\"newModel\", \"TEST-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Location header\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/airports/\"));",
                  "pm.test(\"OPERATIONAL\", () => pm.expect(pm.response.json().status).to.eql(\"OPERATIONAL\"));"
                ]
              }
            }
          ]
        },
