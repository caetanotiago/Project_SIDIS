    {
      "name": "1. Acesso local",
      "item": [
        {
          "name": "US107 — OPO on replica 1 (stored locally)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{atccToken}}"
              }
            ],
            "url": "{{ap1}}/api/airports/OPO"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test(\"B2 contract fields\", () => { pm.expect(a.iataCode).to.eql(\"OPO\"); pm.expect(a.latitude).to.be.a(\"number\"); pm.expect(a.longitude).to.be.a(\"number\"); pm.expect(a.status).to.eql(\"OPERATIONAL\"); });",
                  "pm.test(\"runways present\", () => pm.expect(a.runways.length).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
