@startuml Airports-SD-PeerForwarding
autonumber
title Peer-to-peer query resolution — GET /api/airports/{iata} (US107, contract B2)
actor "ATCC\n(or Flight Routes)" as ATCC
participant "airports-1\n: AirportController" as Ctrl
participant ": SearchAirportsService" as Service
participant ": AirportReplicaQueries" as Queries
participant "airportRepo (H2 #1)" as Repo
participant ": PeerClient" as Peers
participant "airports-2" as R2
participant "airports-3" as R3

activate ATCC
ATCC -> Ctrl : GET /api/airports/lhr\nAuthorization: Bearer JWT
activate Ctrl
Ctrl -> Service : getByIata("lhr")
activate Service
Service -> Service : IataCode.normalize → "LHR"\n(invalid format → 400)
Service -> Queries : findByIata("LHR")
activate Queries
Queries -> Repo : findById("LHR")
Repo --> Queries : empty (not stored here)

Queries -> Peers : findFirst("/api/airports/LHR")
activate Peers
note right of Peers
  Headers: Authorization (same JWT), X-Correlation-Id,
  X-Peer-Hops: 1, X-Service-Key, X-Caller-Instance.
  Parallel calls with timeout + retry + circuit breaker.
end note
par
    Peers -> R2 : GET /api/airports/LHR
    R2 -> R2 : ServiceKeyFilter ✓, JWT ✓\nhops=1 → local lookup only
    R2 --> Peers : 404 (not mine)
else
    Peers -> R3 : GET /api/airports/LHR
    R3 --> Peers : 200 AirportDTO
end
Peers --> Queries : Optional(dto)
deactivate Peers
Queries --> Service : AirportDTO
deactivate Queries
Service --> Ctrl : AirportDTO
deactivate Service
Ctrl --> ATCC : 200 OK (AirportDTO)
deactivate Ctrl

note over ATCC, R3
  No replica has it → 404. A peer down/timing out is counted as unavailable;
  if nobody answered with the airport the response carries X-Partial-Response: true.
end note
@enduml
