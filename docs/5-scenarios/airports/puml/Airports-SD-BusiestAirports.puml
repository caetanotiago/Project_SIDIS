@startuml Airports-SD-BusiestAirports
autonumber
title S5 — Busiest airports (US210) from Flight Routes events, without HTTP
participant "flightroutes-N\n(owner of the route)" as FR
queue "RabbitMQ\naisafe.flightroutes.events" as MQ
participant ": FlightRoutesEventsListener" as L
participant ": RouteCountProjection" as P <<projection>>
participant "KNOWN_ROUTE\n(H2 #1)" as KR <<read model>>
actor "Backoffice Operator" as BO
participant ": AirportStatisticsService" as S <<query>>
participant ": SearchAirportsService" as Q
participant "REPLICATED_AIRPORT\n(H2 #1)" as RA <<read model>>

== continuously, asynchronously ==
FR -> MQ : RouteCreated {routeId, originIata: "LIS", destinationIata: "MAD", version}
MQ -> L : queue airports-1.flightroutes (binding route.*)
L -> P : apply(event)
P -> KR : upsert by routeId (idempotent, stale versions ignored)

== request ==
BO -> S : GET /api/airports/statistics/busiest?limit=3
activate S
S -> P : routeCountsByAirport()
P -> KR : findAll
P --> S : {LIS: 3, MAD: 2, CDG: 1, FNC: 1, OPO: 1}\n(a route counts for origin and destination)
S -> S : sort by count desc, then IATA; top 3
loop each ranked IATA
  S -> Q : findByIata(iata)
  Q -> RA : findById
end
S --> BO : 200 [{rank 1, LIS, Lisbon, 3}, {rank 2, MAD, 2}, {rank 3, CDG, 1}]
deactivate S

note over FR, RA
  Replaces the HTTP bridge B5: Airports answers even while Flight Routes is down, with the routes it already knows.
  The queue is durable: events published while Airports is down wait there.
  Routes published before the queue existed are not received (Flight Routes has no replay yet).
end note
@enduml
