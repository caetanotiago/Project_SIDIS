@startuml Maintenance-Aggregation-SD
title Maintenance — Aggregation with an Unavailable Replica

actor "Gestor" as Ator
participant "Réplica 1" as Replica1
participant "Réplica 2" as Replica2
participant "Réplica 3" as Replica3

Ator -> Replica1: GET /api/maintenance/aircraft/{registration}
activate Replica1
Replica1 -> Replica1: Consultar registos na BD local

par Consultar réplica 2
    Replica1 -> Replica2: GET /api/maintenance/aircraft/{registration}\nX-Service-Key + X-Peer-Hops: 1
    activate Replica2
    Replica2 -> Replica2: Consultar registos na BD local
    Replica2 --> Replica1: 200 OK — registos da réplica 2
    deactivate Replica2
else Consultar réplica 3
    Replica1 -> Replica3: GET /api/maintenance/aircraft/{registration}\nX-Service-Key + X-Peer-Hops: 1
    activate Replica3
    note right of Replica3: Falha de comunicação / Indisponível
    Replica3 --x Replica1: Timeout ou 503 Service Unavailable
    deactivate Replica3
end

Replica1 -> Replica1: Agregar registos e ordenar cronologicamente
Replica1 --> Ator: 200 OK — lista de histórico\nX-Partial-Response: true
deactivate Replica1

@enduml
