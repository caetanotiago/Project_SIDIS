@startuml Maintenance-SD-Alerts
autonumber
title US222 — Alerts for aircraft due for scheduled maintenance (query side, local copies)
actor "ATCC" as User
participant "maintenance-3\n: MaintenanceAlertController" as Ctrl
participant ": MaintenanceAlertService" as Service
participant ": FleetDirectory" as Fleet
participant "KNOWN_AIRCRAFT /\nKNOWN_SCHEDULED_FLIGHT" as Known
participant "Aircraft Management" as AM
participant "read models\n(templates, records)" as RM
participant ": MaintenanceDuePolicy" as Policy <<Domain Service>>

activate User
User -> Ctrl : GET /api/maintenance-alerts
activate Ctrl
Ctrl -> Service : checkFleet()
activate Service

Service -> Fleet : fleet()
activate Fleet
opt first time on this replica (fleet copy not seeded yet)
    Fleet -> AM : GET /api/aircrafts?page=n&size=100 (B3d, once)
    AM --> Fleet : aircraft
    Fleet -> Known : insert the ones not received by event
end
Fleet -> Known : all KNOWN_AIRCRAFT (kept up to date by\nAircraftRegistered / AircraftStatusChanged)
Fleet --> Service : Fleet (partial only if not seeded and AM down)
deactivate Fleet

Service -> Fleet : flightHours()
activate Fleet
alt flight events received (ScheduledFlightCreated from Flight Routes)
    Fleet -> Known : sum(estimatedFlightTime) per aircraft / 60
else none received yet
    Fleet -> AM : GET /api/aircrafts/operational-hours (B3d fallback)
end
Fleet --> Service : FlightHours (reg → hours)
deactivate Fleet

Service -> RM : periodic templates; latest completion per (aircraft, template), ongoing?
RM --> Service : data of every replica

loop each aircraft not INACTIVE × periodic template applicable to its model (no ongoing record)
    Service -> Policy : evaluate(context)
    note right of Policy
      FlightHoursCriterion: hours since last completion >= interval.flightHours
      CalendarDaysCriterion: days since last completion
        (or manufacturing date) >= interval.calendarDays
    end note
    Policy --> Service : Optional<MaintenanceAlert>
end
Service --> Ctrl : alerts
deactivate Service
Ctrl --> User : 200 OK [MaintenanceAlertDTO]
deactivate Ctrl
deactivate User

note over User, Policy
  Computed on demand (conversation 016) and not stored. Any replica gives the same answer from its own
  copies; Aircraft Management and Flight Routes may be down.
end note
@enduml
