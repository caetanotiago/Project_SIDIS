@startuml Maintenance-SD-CreateRecord
autonumber
title US115 — Create a maintenance record (command side, B3b and event)
actor "Maintenance\nTechnician" as User
participant "maintenance-2\n: MaintenanceRecordController" as Ctrl <<Controller>>
participant ": CreateMaintenanceRecordService" as Service <<Service>>
participant ": FleetDirectory" as Fleet
participant "templates\n(read model)" as Tpl <<Repository>>
participant ": MaintenanceRecordFactory" as Factory <<Factory>>
participant "recordRepo\n(write model)" as Repo <<Repository>>
participant ": AircraftAvailabilityService" as Avail <<Service>>
participant "Aircraft Management\n(any replica)" as AM
participant ": MaintenanceEventEmitter" as Emitter
participant ": IntegrationEventRelay" as Relay
queue "RabbitMQ" as MQ

activate User
User -> Ctrl : POST /api/maintenance-records\n(aircraftRegistration, templateId, description,\n startDate, expectedDurationMinutes, component?)
activate Ctrl
Ctrl -> Service : create(dto)
activate Service
note right of Service : @Transactional begins

Service -> Fleet : aircraft(reg)
activate Fleet
alt aircraft in KNOWN_AIRCRAFT (fed by AircraftRegistered / AircraftStatusChanged)
    Fleet --> Service : AircraftSnapshot (local, no HTTP)
else not received yet
    Fleet -> AM : GET /api/aircrafts/{reg} (B3a fallback)
    AM --> Fleet : 200 (or 404 → 404)
    Fleet -> Fleet : remember in KNOWN_AIRCRAFT
    Fleet --> Service : AircraftSnapshot
end
deactivate Fleet

Service -> Tpl : findById(templateId)
Tpl --> Service : ReplicatedMaintenanceTemplate (of ANY replica; else 404)
Service -> Service : template.appliesTo(model) (else 400)
Service -> Factory : create(aircraft, template, dto)
Factory --> Service : record (IN_PROGRESS, checklist copied;\nstartDate <= today, duration > 0 else 400)
Service -> Repo : saveAndFlush(record)

Service -> Avail : markUnderMaintenance(aircraft)
activate Avail
Avail -> AM : PATCH /api/aircrafts/{reg}/status {UNDER_MAINTENANCE} (B3b, HTTP command)
alt 200
    AM --> Avail : 200
    Avail -> Avail : on rollback → PATCH previous status (compensation)
else 409 (IN_FLIGHT) / 404 / 503
    AM --> Avail : error
    Avail --> Service : exception → rollback: no record, no read-model row, no event
    Service --> Ctrl : exception
    Ctrl --> User : 409 / 404 / 503
end
deactivate Avail

Service -> Emitter : recordCreated(saved)
activate Emitter
Emitter -> Emitter : build ONE IntegrationEvent\nMaintenanceRecordCreated (full state, version 0)
Emitter -> Emitter : apply to THIS replica's read model\n(same transaction: read-your-writes)
Emitter -> Relay : OutgoingIntegrationEvent (Spring event)
deactivate Emitter
note right of Service : COMMIT
Relay -> MQ : AFTER COMMIT: publish to aisafe.maintenance.events\n(routing key maintenance-record.created, confirm)
Service --> Ctrl : record
deactivate Service
Ctrl --> User : 201 Created + Location (ownerInstance = maintenance-2)
deactivate Ctrl
deactivate User

note over User, MQ
  Aircraft Management then publishes AircraftStatusChanged (UNDER_MAINTENANCE): Maintenance updates KNOWN_AIRCRAFT,
  Aircraft Management its AIRCRAFT_MOOD (/api/v2/unicorns: GROUNDED_AND_GRUMPY). Flight Routes only schedules AVAILABLE aircraft.
end note
@enduml
