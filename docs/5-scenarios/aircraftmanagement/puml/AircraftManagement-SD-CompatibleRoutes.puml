@startuml AircraftManagement-SD-CompatibleRoutes
autonumber
title Compatible routes (US203) — range of the MODEL, capacity of the AIRCRAFT, routes from Flight Routes events
actor "ATCC" as ATCC
participant ": AircraftStatisticsController" as Ctrl
participant ": FindCompatibleRoutesService" as S <<query>>
participant ": SearchAircraftsService" as A
participant ": SearchAircraftModelsService" as M
database "KNOWN_ROUTE" as K <<read model>>

ATCC -> Ctrl : GET /api/aircrafts/CS-TUA/compatible-routes
activate Ctrl
Ctrl -> S : findFor("CS-TUA")
activate S
S -> A : getByRegistration (404 if unknown)
A --> S : CS-TUA, A320, 180 seats
S -> M : getByName("A320") (404 if unknown)
M --> S : maximumRange 6100 km
S -> K : status = ACTIVE AND minRange ≤ 6100 AND minCapacity ≤ 180
K --> S : routes
S --> Ctrl : List<CompatibleRouteDTO> (same JSON as Flight Routes' FlightRouteDTO)
deactivate S
Ctrl --> ATCC : 200
deactivate Ctrl
@enduml
