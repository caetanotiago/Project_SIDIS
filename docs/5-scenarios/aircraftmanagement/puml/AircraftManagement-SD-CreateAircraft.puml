@startuml AircraftManagement-SD-CreateAircraft
autonumber
title Register an aircraft whose model is owned by another replica (US102) — checks on the read models
actor "ATCC" as ATCC
participant "aircraftmanagement-1\n: AircraftController" as Ctrl
participant ": CreateAircraftService" as Cmd <<command>>
database "REPLICATED_AIRCRAFT\nREPLICATED_AIRCRAFT_MODEL" as RM <<read model>>
database "AIRCRAFT\n(write model, replica 1)" as W
participant ": AircraftManagementEventEmitter" as E
queue "RabbitMQ" as MQ

ATCC -> Ctrl : POST /api/aircrafts {CS-XYZ, model A330, ...}
activate Ctrl
Ctrl -> Cmd : create(dto) (Bean Validation → 400)
activate Cmd
Cmd -> RM : existsById("CS-XYZ")?
alt already known (any replica)
  Cmd --> Ctrl : IllegalStateException → 409
end
Cmd -> RM : model "A330" exists? (owned by replica 2, known by its event)
alt unknown
  Cmd --> Ctrl : IllegalArgumentException → 400
end
Cmd -> W : saveAndFlush(new Aircraft) — replica 1 becomes the owner
Cmd -> E : aircraftRegistered(aircraft)
E -> RM : apply to the local read model (same transaction)
Cmd --> Ctrl : Aircraft
deactivate Cmd
Ctrl --> ATCC : 201 AircraftDTO
deactivate Ctrl
E -> MQ : AircraftRegistered (after commit) → other replicas, Flight Routes, unicorns
note over Cmd, RM
  No peer call. Inside the consistency window (an aircraft registered on another replica
  whose event has not arrived yet) a duplicate can slip through — the accepted price of AP.
end note
@enduml
