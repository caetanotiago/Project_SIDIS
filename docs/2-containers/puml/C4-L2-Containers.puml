@startuml C4-L2-Containers
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title AISafe — Containers (C4 Level 2, Assignment 2)

AddRelTag("amqp", $lineColor="#d9480f", $textColor="#d9480f", $lineStyle=DashedLine())
AddRelTag("planned", $lineColor="#868e96", $textColor="#868e96", $lineStyle=DottedLine())

Person(backoffice, "Backoffice Operator")
Person(atcc, "ATCC")
Person(maint, "Maintenance Technician / Supervisor")

System_Boundary(aisafe, "AISafe Flight Management System") {
    Container(am, "Aircraft Management Service", "Java 21, Spring Boot — 3 replicas :8081/:8181/:8281", "Aircraft models and aircraft, operational status (WP#1).")
    Container(mt, "Maintenance Service", "Java 21, Spring Boot — 3 replicas :8082/:8182/:8282", "Maintenance templates, records, reports and alerts (WP#4).")
    Container(ap, "Airports Service", "Java 21, Spring Boot — 3 replicas :8083/:8183/:8283", "Airports, runways and certification data (WP#2).")
    Container(fr, "Flight Routes Service", "Java 21, Spring Boot, Spring AMQP — 3 replicas :8084/:8184/:8284", "Flight routes, history, scheduled flights, network queries (WP#3). CQRS: commands on the owner's write model, queries on local read models built from events.")

    ContainerQueue(mq, "Message broker", "RabbitMQ 3 (Docker) — AMQP :5672", "Topic exchange per producer (aisafe.<service>.events), one durable queue per consuming replica (<instanceId>.<source>), dead-letter queues.")

    ContainerDb(amdb, "aircraftManagementdb-1..3", "H2 file", "One database per replica: write model + read models")
    ContainerDb(mtdb, "maintenancedb-1..3", "H2 in-memory", "One database per replica")
    ContainerDb(apdb, "airportsdb-1..3", "H2 in-memory", "One database per replica")
    ContainerDb(frdb, "flightRoutesdb-1..3", "H2 file (code/data/)", "One database per replica: write model (owned rows) + read models (all replicas) + processed event ids")
}

' Users: REST is kept for every external client (roles as in each service's AuthorizationRules)
Rel(backoffice, am, "Registers aircraft models (US101); US204 top models; reads fleet", "REST, JSON/HTTPS + JWT")
Rel(backoffice, ap, "Registers and updates airports, status, certifications; US210 busiest airports", "REST, JSON/HTTPS + JWT")
Rel(backoffice, fr, "Updates / deactivates routes (US112)", "REST, JSON/HTTPS + JWT")
Rel(atcc, am, "Registers aircraft (US102), status (US105); US203, US204, US206", "REST, JSON/HTTPS + JWT")
Rel(atcc, ap, "Airport details, search, grouping (US107, US108, US211); certifications", "REST, JSON/HTTPS + JWT")
Rel(atcc, fr, "Routes, scheduled flights, network queries", "REST, JSON/HTTPS + JWT")
Rel(atcc, mt, "US117, US220, US222 alerts", "REST, JSON/HTTPS + JWT")
Rel(maint, mt, "Templates, records, categorisation, ongoing records, turnaround report", "REST, JSON/HTTPS + JWT")
Rel(maint, am, "Reads aircraft and models; status (US105)", "REST, JSON/HTTPS + JWT")

' Remaining synchronous bridges (user's JWT + X-Service-Key; round-robin + failover)
Rel(fr, ap, "B2: GET /api/airports/{iata} (until Airports publishes events)", "JSON/HTTPS")
Rel(fr, am, "B1: GET aircraft / model (events available; consumer off by default)", "JSON/HTTPS")
Rel(ap, fr, "B5: routes per airport (answered from read model)", "JSON/HTTPS, service-only")
Rel(mt, am, "B3: aircraft, models, fleet + hours; PATCH status (command)", "JSON/HTTPS")
Rel(fr, fr, "Commands forwarded to the replica that owns the entity", "JSON/HTTPS, X-Peer-Hops + X-Service-Key")

' Events (Assignment 2)
Rel(fr, mq, "Publishes RouteCreated, RouteUpdated, ScheduledFlightCreated (after commit)", "AMQP", $tags="amqp")
Rel(mq, fr, "Delivers every Flight Routes event to every replica's queue → read models", "AMQP", $tags="amqp")
Rel(am, mq, "AircraftRegistered, AircraftStatusChanged, AircraftModelCreated/Updated; consumes route.*, scheduled-flight.* (replaces B4b, B6)", "AMQP", $tags="amqp")
Rel(ap, mq, "AirportCreated, AirportUpdated, AirportStatusChanged (to implement)", "AMQP", $tags="planned")

Rel(am, amdb, "Reads/writes", "JPA/JDBC")
Rel(mt, mtdb, "Reads/writes", "JPA/JDBC")
Rel(ap, apdb, "Reads/writes", "JPA/JDBC")
Rel(fr, frdb, "Writes owned rows; projects events; reads read models", "JPA/JDBC")

SHOW_LEGEND()
@enduml
