@startuml Airports-CD
!pragma layout smetana
skinparam classAttributeIconSize 0
hide empty members
title Airports — class diagram (CQRS: command side, query side and event flow)

package controllers {
    class AirportController
}

package command <<write side>> {
    class RegisterAirportService {
        + register(CreateAirportDTO) : Airport
    }
    class UpdateAirportService {
        + addCertification(...) : AirportDTO
        + changeStatus(...) : AirportDTO
        + updateDetails(...) : AirportDTO
        - onOwner(iata, method, subPath, body, change, announce)
    }
    class AirportEventEmitter {
        + airportCreated(Airport)
        + airportUpdated(Airport)
        + airportStatusChanged(Airport)
    }
    class IntegrationEventRelay {
        + afterCommit(OutgoingIntegrationEvent)
    }
    interface IntegrationEventTransport {
        + send(OutgoingIntegrationEvent)
    }
    class AirportStateRepublisher {
        + republishOwnedAirports(reason) : int
    }
    class ReadModelSynchronizer {
        + onStartup()
        + onSyncRequested(requestedBy)
    }
}

package query <<read side>> {
    class SearchAirportsService {
        + getByIata(String) : AirportDTO
        + search(city, country, name) : List<AirportDTO>
    }
    class GroupAirportsService
    class AirportStatisticsService {
        + busiestAirports(Integer)
    }
    class AirportProjection {
        + apply(IntegrationEvent<AirportEventPayload>) : boolean
    }
    class ReplicatedAirport <<read model>>
    interface ReplicatedAirportRepository
    class RouteCountProjection {
        + apply(IntegrationEvent<FlightRouteEventPayload>) : boolean
        + routeCountsByAirport() : Map<String, Long>
    }
    class KnownRoute <<read model>>
}

package infrastructure.messaging {
    class RabbitIntegrationEventTransport
    class AirportsEventsListener {
        + on(IntegrationEvent<JsonNode>)
    }
    class FlightRoutesEventsListener {
        + on(IntegrationEvent<FlightRouteEventPayload>)
    }
    class JpaProcessedEventStore
}

package domain {
    class Airport <<Root>>
}
interface AirportRepository
class AirportFactory

package "common (library)" {
    class PeerClient {
        + forwardToOwner(method, uri, body, type)
    }
    class EventPublisher {
        + publish(event, routingKey)
    }
    class IdempotentEventHandler
}

AirportController --> RegisterAirportService
AirportController --> UpdateAirportService
AirportController --> SearchAirportsService
AirportController --> GroupAirportsService
AirportController --> AirportStatisticsService

RegisterAirportService --> AirportFactory
RegisterAirportService --> AirportRepository
RegisterAirportService --> ReplicatedAirportRepository : IATA unique?
RegisterAirportService --> AirportEventEmitter
UpdateAirportService --> AirportRepository
UpdateAirportService --> PeerClient : not the owner
UpdateAirportService --> AirportEventEmitter
AirportEventEmitter --> AirportProjection : same transaction
AirportEventEmitter ..> IntegrationEventRelay : OutgoingIntegrationEvent
IntegrationEventRelay --> IntegrationEventTransport : after commit
RabbitIntegrationEventTransport ..|> IntegrationEventTransport
RabbitIntegrationEventTransport --> EventPublisher
ReadModelSynchronizer --> AirportStateRepublisher
ReadModelSynchronizer --> EventPublisher : AirportSyncRequested
AirportStateRepublisher --> AirportEventEmitter

AirportsEventsListener --> AirportProjection
AirportsEventsListener --> ReadModelSynchronizer
FlightRoutesEventsListener --> RouteCountProjection
AirportProjection --> ReplicatedAirportRepository
AirportProjection --> IdempotentEventHandler
RouteCountProjection --> KnownRoute
RouteCountProjection --> IdempotentEventHandler
IdempotentEventHandler ..> JpaProcessedEventStore : ProcessedEventStore
ReplicatedAirportRepository ..> ReplicatedAirport
SearchAirportsService --> ReplicatedAirportRepository
GroupAirportsService --> SearchAirportsService
AirportStatisticsService --> RouteCountProjection
AirportStatisticsService --> SearchAirportsService
AirportFactory ..> Airport : creates
AirportRepository ..> Airport
@enduml
