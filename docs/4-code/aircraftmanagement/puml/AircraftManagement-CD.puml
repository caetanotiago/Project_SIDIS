@startuml AircraftManagement-CD
!pragma layout smetana
skinparam classAttributeIconSize 0
hide empty members
title Aircraft Management — classes (Assignment 2, CQRS)

package controllers {
    class AircraftController
    class AircraftModelController
    class AircraftStatisticsController
    class AircraftModelStatisticsController
    class AircraftAvailabilityController
    class UnicornsController {
        + moods() : List<AircraftMoodDTO>
    }
}

package command {
    class CreateAircraftModelService {
        + create(CreateAircraftModelDTO) : AircraftModel
    }
    class UpdateAircraftModelService {
        + update(String, UpdateAircraftModelDTO) : AircraftModelDTO
    }
    class CreateAircraftService {
        + create(CreateAircraftDTO) : Aircraft
    }
    class UpdateAircraftStatusService {
        + updateStatus(String, UpdateAircraftStatusDTO) : AircraftDTO
    }
    class AircraftManagementEventEmitter {
        + aircraftRegistered(Aircraft)
        + aircraftStatusChanged(Aircraft)
        + aircraftModelCreated(AircraftModel)
        + aircraftModelUpdated(AircraftModel)
    }
    class OutgoingIntegrationEvent <<record>>
    class IntegrationEventRelay {
        + afterCommit(OutgoingIntegrationEvent)
    }
    interface IntegrationEventTransport {
        + send(OutgoingIntegrationEvent)
    }
    class AircraftStateRepublisher {
        + republishOwnedState(String) : int
    }
    class ReadModelSynchronizer {
        + onStartup()
        + onSyncRequested(String)
    }
}

package events {
    class AircraftEvents <<contract>>
    class AircraftEventPayload <<record>>
    class AircraftModelEvents <<contract>>
    class AircraftModelEventPayload <<record>>
    package external {
        class FlightRoutesEvents <<contract>>
        class RoutePayload <<record>>
        class ScheduledFlightPayload <<record>>
    }
}

package query {
    class AircraftManagementEventRouter {
        + apply(IntegrationEvent<?>) : boolean
    }
    class AircraftManagementEventsListener <<@RabbitListener>>
    class AircraftProjection
    class AircraftModelProjection
    class ReplicatedAircraft <<read model>>
    class ReplicatedAircraftModel <<read model>>
    class AircraftMood <<read model>> {
        + {static} moodOf(String) : String
    }
    class SearchAircraftsService
    class SearchAircraftModelsService
    class AircraftAvailabilityService
    class CalculateOperationalHoursService
    class TopUtilizedModelsService
    class FindCompatibleRoutesService
    class FlightMinutesService
    class AircraftMoodQueryService
    package "query.external" as qext {
        class FlightRoutesEventsListener <<@RabbitListener>>
        class FlightRoutesEventsProjection
        class KnownRoute <<read model>>
        class KnownScheduledFlight <<read model>>
    }
}

package domain {
    class Aircraft <<Root>>
    class AircraftModel <<Root>>
    enum AircraftStatus
}

package "infrastructure.messaging" as infra {
    class RabbitIntegrationEventTransport
    class AircraftManagementMessagingConfiguration
    class JpaProcessedEventStore
}

package "common (isep.sidis.common)" as common {
    class EventPublisher
    class IdempotentEventHandler
    class PeerClient
    class "IntegrationEvent<T>" as IE <<record>>
}

AircraftController --> CreateAircraftService
AircraftController --> UpdateAircraftStatusService
AircraftController --> SearchAircraftsService
AircraftModelController --> CreateAircraftModelService
AircraftModelController --> UpdateAircraftModelService
AircraftModelController --> SearchAircraftModelsService
AircraftStatisticsController --> CalculateOperationalHoursService
AircraftStatisticsController --> FindCompatibleRoutesService
AircraftModelStatisticsController --> TopUtilizedModelsService
AircraftAvailabilityController --> AircraftAvailabilityService
UnicornsController --> AircraftMoodQueryService

CreateAircraftService --> Aircraft
CreateAircraftModelService --> AircraftModel
UpdateAircraftStatusService --> PeerClient : forwardToOwner
UpdateAircraftModelService --> PeerClient : forwardToOwner
CreateAircraftService ..> ReplicatedAircraft : uniqueness
CreateAircraftService ..> ReplicatedAircraftModel : model exists
CreateAircraftModelService ..> ReplicatedAircraftModel : uniqueness
CreateAircraftService --> AircraftManagementEventEmitter
CreateAircraftModelService --> AircraftManagementEventEmitter
UpdateAircraftStatusService --> AircraftManagementEventEmitter
UpdateAircraftModelService --> AircraftManagementEventEmitter
AircraftStateRepublisher --> AircraftManagementEventEmitter
ReadModelSynchronizer --> AircraftStateRepublisher
ReadModelSynchronizer --> EventPublisher : AircraftSyncRequested
AircraftManagementEventsListener --> ReadModelSynchronizer : sync request

AircraftManagementEventEmitter --> AircraftManagementEventRouter : apply (same tx)
AircraftManagementEventEmitter ..> OutgoingIntegrationEvent : publishEvent
IntegrationEventRelay ..> OutgoingIntegrationEvent : AFTER_COMMIT
IntegrationEventRelay --> IntegrationEventTransport
RabbitIntegrationEventTransport ..|> IntegrationEventTransport
RabbitIntegrationEventTransport --> EventPublisher

AircraftManagementEventsListener --> AircraftManagementEventRouter
AircraftManagementEventRouter --> AircraftProjection
AircraftManagementEventRouter --> AircraftModelProjection
AircraftProjection --> ReplicatedAircraft
AircraftProjection --> AircraftMood
AircraftModelProjection --> ReplicatedAircraftModel
AircraftProjection --> IdempotentEventHandler
AircraftModelProjection --> IdempotentEventHandler
FlightRoutesEventsProjection --> IdempotentEventHandler
IdempotentEventHandler --> JpaProcessedEventStore : ProcessedEventStore
FlightRoutesEventsListener --> FlightRoutesEventsProjection
FlightRoutesEventsProjection --> KnownRoute
FlightRoutesEventsProjection --> KnownScheduledFlight

SearchAircraftsService --> ReplicatedAircraft
SearchAircraftModelsService --> ReplicatedAircraftModel
AircraftAvailabilityService --> SearchAircraftsService
CalculateOperationalHoursService --> SearchAircraftsService
CalculateOperationalHoursService --> FlightMinutesService
TopUtilizedModelsService --> SearchAircraftsService
TopUtilizedModelsService --> FlightMinutesService
FlightMinutesService --> KnownScheduledFlight
FindCompatibleRoutesService --> SearchAircraftsService
FindCompatibleRoutesService --> SearchAircraftModelsService
FindCompatibleRoutesService --> KnownRoute
AircraftMoodQueryService --> AircraftMood

AircraftEventPayload ..> Aircraft : of()
AircraftModelEventPayload ..> AircraftModel : of()
Aircraft --> AircraftStatus
@enduml
