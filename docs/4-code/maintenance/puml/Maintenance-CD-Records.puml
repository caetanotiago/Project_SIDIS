@startuml Maintenance-CD-Records
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
title Maintenance records — command side (US115 records, US119, US217) and query side (US116, US218, US219)

package "Presentation" {
    class MaintenanceRecordController <<Controller>> {
        + create(dto : CreateMaintenanceRecordDTO)
        + complete(id, dto : CompleteMaintenanceRecordDTO)
        + categorize(id, dto : CategorizeRecordDTO)
        + getById(id)
        + byAircraft(registration, page, size)
        + search(aircraft?, component?, status?, from?, to?, page, size)
        + ongoing(page, size)
    }
    class MaintenanceRecordAssembler <<Component>> {
        + toDTO(record : MaintenanceRecord)
        + toDTO(row : ReplicatedMaintenanceRecord)
        + withLinks(dto)
    }
}

package "command" {
    class CreateMaintenanceRecordService <<Service>> {
        + create(dto) : MaintenanceRecord
    }
    class CompleteMaintenanceRecordService <<Service>> {
        + complete(id, dto) : Result(record, aircraftReleased)
    }
    class CategorizeMaintenanceRecordService <<Service>> {
        + categorize(id, dto) : MaintenanceRecordDTO
    }
    class AircraftAvailabilityService <<Service>> {
        + markUnderMaintenance(aircraft)
        + releaseIfNoOtherOngoing(reg, recordId) : boolean
    }
    class MaintenanceEventEmitter <<Component>> {
        + recordCreated(record)
        + recordCategorized(record)
        + recordCompleted(record)
    }
}

package "query" {
    class ViewMaintenanceRecordsService <<Service>> {
        + getById(id)
        + byAircraft(reg, page, size) : PageDTO
        + search(filter, page, size) : PageDTO
        + ongoing(page, size) : PageDTO
    }
    class RecordFilter <<Value Object>> {
        aircraft, component, status, from, to
        + matches(row) : boolean
    }
    interface ReplicatedMaintenanceRecordRepository <<Repository>>
    interface ReplicatedMaintenanceTemplateRepository <<Repository>>
    class FleetDirectory <<Component>> {
        + aircraft(reg) : AircraftSnapshot
    }
}

package "Domain (write model)" {
    class MaintenanceRecordFactory <<Factory>>
    class MaintenanceRecord <<Entity>> <<Root>> {
        + complete(details)
        + categorize(component)
    }
    interface MaintenanceRecordRepository <<Repository>>
}

package "Integration" {
    class AircraftClient <<ACL>> {
        + updateStatus(reg, status)
    }
    class "PeerClient\n(common)" as PeerClient {
        + forwardToOwner(PATCH, uri, body)
        + isPeerRequest()
    }
}

MaintenanceRecordController --> CreateMaintenanceRecordService : POST
MaintenanceRecordController --> CompleteMaintenanceRecordService : PATCH
MaintenanceRecordController --> CategorizeMaintenanceRecordService : PATCH
MaintenanceRecordController --> ViewMaintenanceRecordsService : GET
MaintenanceRecordController --> MaintenanceRecordAssembler

CreateMaintenanceRecordService --> FleetDirectory : aircraft + model\n(local copy, HTTP fallback)
CreateMaintenanceRecordService --> ReplicatedMaintenanceTemplateRepository : template (any replica)
CreateMaintenanceRecordService --> MaintenanceRecordFactory
CreateMaintenanceRecordService --> MaintenanceRecordRepository : saveAndFlush
CreateMaintenanceRecordService --> AircraftAvailabilityService
CreateMaintenanceRecordService --> MaintenanceEventEmitter
CompleteMaintenanceRecordService --> MaintenanceRecordRepository
CompleteMaintenanceRecordService --> PeerClient : not the owner
CompleteMaintenanceRecordService --> AircraftAvailabilityService
CompleteMaintenanceRecordService --> MaintenanceEventEmitter
CategorizeMaintenanceRecordService --> PeerClient : not the owner
CategorizeMaintenanceRecordService --> MaintenanceEventEmitter
AircraftAvailabilityService --> AircraftClient : B3b
AircraftAvailabilityService --> ReplicatedMaintenanceRecordRepository : other ongoing records
ViewMaintenanceRecordsService --> ReplicatedMaintenanceRecordRepository
ViewMaintenanceRecordsService --> FleetDirectory : US116 aircraft exists
ViewMaintenanceRecordsService ..> RecordFilter
MaintenanceRecordFactory ..> MaintenanceRecord : creates
MaintenanceRecordRepository ..> MaintenanceRecord : persists
@enduml
