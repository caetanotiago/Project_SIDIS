@startuml Maintenance-CD-TemplatesReports
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
title Templates (US115), statistics (US117, US220, US221) and alerts (US222)

package "Presentation" {
    class MaintenanceTemplateController <<Controller>> {
        + create(dto : CreateMaintenanceTemplateDTO)
        + getById(id)
        + list(model?, type?, name?)
    }
    class MaintenanceStatisticsController <<Controller>> {
        + maintenanceHours()
        + costs(groupBy)
        + turnaround()
    }
    class MaintenanceAlertController <<Controller>> {
        + alerts()
    }
}

package "command" {
    class CreateMaintenanceTemplateService <<Service>> {
        + create(dto) : MaintenanceTemplate
    }
    class MaintenanceEventEmitter <<Component>> {
        + templateCreated(template)
    }
}

package "query" {
    class ViewMaintenanceTemplatesService <<Service>> {
        + getById(id)
        + list(model?, type?, name?)
        + periodic()
    }
    class MaintenanceStatisticsService <<Service>> {
        + maintenanceHours()
        + costs(grouping : CostGrouping)
        + turnaround()
        + lastCompletions() : Map
    }
    class MaintenanceAlertService <<Service>> {
        + checkFleet() : AlertResult
    }
    interface ReplicatedMaintenanceTemplateRepository <<Repository>> {
        + existsByNameIgnoreCase(name)
    }
    interface ReplicatedMaintenanceRecordRepository <<Repository>> {
        + findByStatus(status)
    }
    class FleetDirectory <<Component>> {
        + modelExists(model)
        + fleet() : Fleet
        + flightHours() : FlightHours
    }
}

package "Domain" {
    class MaintenanceTemplateFactory <<Factory>>
    class MaintenanceTemplate <<Entity>> <<Root>> {
        + appliesTo(model) : boolean
        + isPeriodic() : boolean
    }
    interface MaintenanceTemplateRepository <<Repository>>
    enum CostGrouping <<Strategy>> {
        AIRCRAFT
        MODEL
        + keyOf(registration, model)
    }
    class MaintenanceDuePolicy <<Domain Service>>
    interface DueCriterion <<Strategy>>
    class FlightHoursCriterion
    class CalendarDaysCriterion
    MaintenanceDuePolicy o-- DueCriterion
    DueCriterion <|.. FlightHoursCriterion
    DueCriterion <|.. CalendarDaysCriterion
}

MaintenanceTemplateController --> CreateMaintenanceTemplateService : POST
MaintenanceTemplateController --> ViewMaintenanceTemplatesService : GET
MaintenanceStatisticsController --> MaintenanceStatisticsService
MaintenanceAlertController --> MaintenanceAlertService

CreateMaintenanceTemplateService --> MaintenanceTemplateFactory
CreateMaintenanceTemplateService --> ReplicatedMaintenanceTemplateRepository : unique name (all replicas)
CreateMaintenanceTemplateService --> FleetDirectory : models exist (B3c / KNOWN_AIRCRAFT_MODEL)
CreateMaintenanceTemplateService --> MaintenanceTemplateRepository : saveAndFlush
CreateMaintenanceTemplateService --> MaintenanceEventEmitter
ViewMaintenanceTemplatesService --> ReplicatedMaintenanceTemplateRepository
MaintenanceStatisticsService --> ReplicatedMaintenanceRecordRepository
MaintenanceStatisticsService ..> CostGrouping
MaintenanceAlertService --> FleetDirectory : KNOWN_AIRCRAFT,\nKNOWN_SCHEDULED_FLIGHT
MaintenanceAlertService --> ViewMaintenanceTemplatesService : periodic templates
MaintenanceAlertService --> MaintenanceStatisticsService : last completions
MaintenanceAlertService --> MaintenanceDuePolicy
MaintenanceTemplateFactory ..> MaintenanceTemplate : creates
MaintenanceTemplateRepository ..> MaintenanceTemplate : persists
@enduml
